# YouTube Data API v3 key — server-side only, never NEXT_PUBLIC_*
YOUTUBE_API_KEY=

# Local SQLite database file
DATABASE_PATH=./data/creator-hub.db

# Daily quota allowance shown in the usage meter (Google default is 10000)
YOUTUBE_DAILY_QUOTA=10000

# --- Gmail OAuth2: connect a mailbox from the Settings screen ---
# Google Cloud Console → enable Gmail API → OAuth consent screen → Credentials
# → OAuth client ID (Web application). Authorized redirect URI:
#   http://localhost:3000/api/mail/gmail/callback
# The scope used is gmail.send only; the inbox is never read.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Defaults to <request origin>/api/mail/gmail/callback.
# Set this when the app does not run on http://localhost:3000.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/mail/gmail/callback

# Optional. Key used to encrypt the stored Gmail tokens (32 bytes, base64/hex).
# When omitted, a random key is written to data/.mail-token-key with 0600.
# MAIL_TOKEN_KEY=

# --- SMTP fallback: used only while no Gmail account is connected ---
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it WITHOUT spaces.
# Any SMTP server works (Brevo, Mailjet, Ethereal for local testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=Your Studio
# Optional: defaults to SMTP_USER. Most providers reject a different From.
# SMTP_FROM_EMAIL=
# Optional: daily send cap. Warming a fresh mailbox means starting at 10-20 a
# day and raising it slowly — 200 on day one is the shortest route to spam.
SMTP_DAILY_LIMIT=20
# Optional: minimum seconds between two sends. Several mails a minute apart is
# what a bulk sender looks like.
MAIL_SEND_INTERVAL_SECONDS=120
